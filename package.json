{
  "name": "@bihangchi9/lark-agent-bridge",
  "version": "0.0.4",
  "description": "Feishu/Lark bridge for local coding agents — one group, one conversation, one pinned runtime. Bridges dsh, CLI agents (traex/codex), an IDE window, or a custom agent behind one gateway.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "lark-agent-register": "lib/register-cli.js",
    "lark-agent-bridge": "lib/daemon.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "docs/verification-0.0.4.md",
    "SKILL.md",
    "scripts/setup.sh",
    "scripts/setup.ps1",
    "presets/**",
    "tools/lark-cli/package.json",
    "tools/lark-cli/lib/**/*.js",
    "tools/lark-cli/lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tools/lark-cli/tsconfig.json",
    "pack:checked": "pnpm run build && node scripts/verify-distribution.mjs && npm pack --ignore-scripts",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "test:disposable": "node scripts/test-disposable-dsh.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "register": "node lib/register-cli.js",
    "setup": "bash scripts/setup.sh",
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "feishu",
    "lark",
    "bot",
    "coding-agent",
    "traex",
    "codex",
    "agent-bridge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
      "dshReleases": {
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.4": "compatible",
        "0.2.2-rc.5": "compatible"
      },
      "dshOperations": {
        "0.2.2-rc.3": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.2.2-rc.4": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.2.2-rc.5": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        }
      }
    }
  },
  "dependencies": {
    "@larksuite/channel": "0.4.1",
    "cross-spawn": "7.0.6",
    "qrcode-terminal": "0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bihangchi9-creator/lark-agent-bridge.git"
  },
  "homepage": "https://github.com/bihangchi9-creator/lark-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/bihangchi9-creator/lark-agent-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
