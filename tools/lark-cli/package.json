{
  "name": "dsh-tool-lark-cli",
  "version": "0.0.2",
  "description": "A dsh tool that runs lark-cli (Feishu/Lark CLI) commands from an agent — Feishu operations inside agent presets.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "dsh",
    "dsh-tool",
    "feishu",
    "lark",
    "lark-cli"
  ],
  "license": "MIT",
  "dependencies": {
    "cross-spawn": "7.0.6"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
